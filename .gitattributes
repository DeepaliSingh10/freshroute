# Normalize line endings to LF in the repository so artifact hashes and diffs are
# stable across Windows and POSIX checkouts.
* text=auto
*.py   text eol=lf
*.json text eol=lf
*.md   text eol=lf
*.yaml text eol=lf
*.yml  text eol=lf
*.ts   text eol=lf
*.tsx  text eol=lf
*.css  text eol=lf
*.html text eol=lf
